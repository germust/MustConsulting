# Copiar este archivo como .env.local para desarrollo, o cargar las variables
# en Vercel → Project → Settings → Environment Variables.
# Ninguna de estas variables es secreta: se incluyen en el sitio público.

# Dominio definitivo del sitio, sin barra final (canonical, sitemap, Open Graph).
# Si queda vacío, en Vercel se usa el dominio de producción del proyecto.
NEXT_PUBLIC_SITE_URL=

# Versión de prueba: el sitio no se indexa en buscadores salvo que valga "true".
# El sitio final es la versión animada (germust/mustconsultinganimation).
NEXT_PUBLIC_ALLOW_INDEXING=

# Endpoint de un servicio de formularios (por ejemplo https://formspree.io/f/xxxxxxx).
# Si queda vacío, el formulario prepara un mensaje de WhatsApp o un correo.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
